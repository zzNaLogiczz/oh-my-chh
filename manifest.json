{
  "manifest_version": 3,
  "name": "oh-my-chh",
  "short_name": "oh-my-chh",
  "version": "0.2.0",
  "description": "Chiphell（chh）论坛专用美化插件，可自由选择多款样式。",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "oh-my-chh",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/chh-icon-16.png",
      "32": "icons/chh-icon-32.png",
      "48": "icons/chh-icon-48.png",
      "128": "icons/chh-icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chiphell.com/*"
      ],
      "css": [
        "content/preflight.css"
      ],
      "js": [
        "content/main.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "excel/app.html",
        "excel/app.js",
        "excel/app.css"
      ],
      "matches": [
        "https://www.chiphell.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/chh-icon-16.png",
    "32": "icons/chh-icon-32.png",
    "48": "icons/chh-icon-48.png",
    "128": "icons/chh-icon-128.png"
  },
  "options_ui": {
    "page": "excel/options.html",
    "open_in_tab": true
  }
}
